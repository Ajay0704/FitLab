{
  "error": "ProductNotFound",
  "message": "No size data available for product SKU-99999",
  "suggestion": "Try searching by brand and category instead"
}

// ERROR: 500 Internal Server Error
{
  "error": "ModelError",
  "message": "Failed to generate try-on image",
  "retry_after": 30,
  "support_ticket": "TECH-2024-001"
}